{
  "name": "chatbot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "chatbot": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "npm run clean && tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "chat": "npm run build && node dist/index.js chat",
    "query": "npm run build && node dist/index.js query",
    "test-connection": "npm run build && node dist/index.js test",
    "demo": "npm run build && node dist/examples/langgraph-demo.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@langchain/langgraph": "^0.2.74",
    "@supabase/supabase-js": "^2.55.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.5",
    "ora": "^8.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "~5.8.3"
  }
}
